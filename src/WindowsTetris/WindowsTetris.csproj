<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WindowsTetris</RootNamespace>
    <AssemblyName>WindowsTetris</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (Fluent theme) is shipped as an experimental API; opt in. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Audio\*" />
    <Content Include="Assets\Audio\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTetris.Core\WindowsTetris.Core.csproj" />
  </ItemGroup>

</Project>
