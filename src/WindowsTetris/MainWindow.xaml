<Window x:Class="WindowsTetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetris" Height="684" Width="760"
        MinHeight="640" MinWidth="720"
        ThemeMode="Dark"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BgStop0" Color="#0A0E18" Offset="0" />
                <GradientStop x:Name="BgStop1" Color="#0F1626" Offset="0.5" />
                <GradientStop x:Name="BgStop2" Color="#0A0E18" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ===================== MAIN GAME LAYOUT ===================== -->
        <Grid x:Name="GameRoot" Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: title + stats -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="TETRIS" FontSize="40" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="ModeText" Text="INFINITE MODE"
                           Foreground="{DynamicResource LabelBrush}" FontWeight="SemiBold"
                           Margin="0,0,0,18" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCORE" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="ScoreText" Text="0" Style="{StaticResource StatValue}" />

                        <TextBlock Text="LEVEL" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="LevelText" Text="1" Style="{StaticResource StatValue}" />

                        <TextBlock Text="LINES" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="LinesText" Text="0" Style="{StaticResource StatValue}" />

                        <TextBlock Text="TIME" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="TimeText" Text="00:00" Style="{StaticResource StatValue}"
                                   Margin="0,0,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="StagePanel" Style="{StaticResource Card}" Margin="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="STAGE" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="StageText" Text="1" Style="{StaticResource StatValue}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="GEMS LEFT" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="GemsText" Text="0" Style="{StaticResource StatValue}"
                                   Margin="0,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center: playfield -->
            <Border x:Name="BoardBorder" Grid.Column="1" CornerRadius="16" Padding="10"
                    Background="{DynamicResource BoardBackBrush}"
                    BorderBrush="{DynamicResource BoardBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect x:Name="BoardGlow" Color="#0022D3EE" BlurRadius="40"
                                      ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
                <Canvas x:Name="BoardCanvas" Width="280" Height="560" />
            </Border>

            <!-- Right: next piece + controls -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="22,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NEXT" Style="{StaticResource StatLabel}" />
                        <Canvas x:Name="NextCanvas" Width="120" Height="120"
                                HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Button x:Name="PauseButton" Content="Pause (P)" Click="OnPauseClick"
                                Margin="0,0,0,8" Padding="10,8" />
                        <Button x:Name="RestartButton" Content="Restart (R)" Click="OnRestartClick"
                                Margin="0,0,0,8" Padding="10,8" />
                        <Button x:Name="MuteButton" Content="Mute (M)" Click="OnMuteClick"
                                Margin="0,0,0,8" Padding="10,8" />
                        <Button x:Name="ThemeButton" Content="Theme (T)" Click="OnThemeClick"
                                Margin="0,0,0,8" Padding="10,8" />
                        <Button x:Name="MenuButton" Content="Main Menu" Click="OnMenuClick"
                                Padding="10,8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="CONTROLS" Style="{StaticResource StatLabel}" />
                        <TextBlock Foreground="{DynamicResource ControlsTextBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18">
                            &#x25C0; &#x25B6;  Move<LineBreak/>
                            &#x25B2;  Rotate<LineBreak/>
                            &#x25BC;  Soft drop<LineBreak/>
                            Space  Hard drop<LineBreak/>
                            T  Theme
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== MESSAGE OVERLAY ===================== -->
        <Grid x:Name="MessageOverlay" Background="{DynamicResource OverlayBgBrush}"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource MessageBgBrush}" CornerRadius="18" Padding="48,32"
                    BorderBrush="{DynamicResource MessageBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="MessageText" Text="PAUSED" FontSize="40" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MessageSub" Text="Press P to resume" FontSize="14"
                               Foreground="{DynamicResource LabelBrush}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== START MENU ===================== -->
        <Grid x:Name="MenuOverlay">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="MenuStop0" Color="#0A0E18" Offset="0" />
                    <GradientStop x:Name="MenuStop1" Color="#101A30" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <TextBlock Text="TETRIS" FontSize="64" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Choose a mode to start"
                           Foreground="{DynamicResource LabelBrush}" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,4,0,32" />

                <Button Content="STAGE  MODE" Click="OnStartStage"
                        FontSize="18" FontWeight="SemiBold" Padding="0,16" Margin="0,0,0,14" />
                <Button Content="INFINITE  MODE" Click="OnStartInfinite"
                        FontSize="18" FontWeight="SemiBold" Padding="0,16" Margin="0,0,0,14" />

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="THEME" Style="{StaticResource StatLabel}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ThemeDarkBtn" Content="Dark" Click="OnThemeDark"
                                    Padding="16,8" Margin="0,0,8,0" />
                            <Button x:Name="ThemeLightBtn" Content="Light" Click="OnThemeLight"
                                    Padding="16,8" Margin="0,0,8,0" />
                            <Button x:Name="ThemeRetroBtn" Content="Retro" Click="OnThemeRetro"
                                    Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock TextAlignment="Center" Foreground="{DynamicResource MenuHintBrush}"
                           FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="18">
                    Stage mode: clear every gem to advance through 20 stages.<LineBreak/>
                    Infinite mode: classic endless Tetris.
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
